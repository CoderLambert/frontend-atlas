{
  "name": "frontend-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-content-index.mjs",
    "dev": "next dev",
    "local:dev": "node scripts/local-app.mjs dev",
    "local:build": "node scripts/local-app.mjs build",
    "local:start": "node scripts/local-app.mjs start",
    "prebuild": "node scripts/generate-content-index.mjs",
    "build": "next build",
    "prelint": "node scripts/generate-content-index.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/migrate-sqlite.mjs",
    "db:backup": "node scripts/backup-sqlite.mjs",
    "db:restore": "node scripts/restore-sqlite.mjs",
    "test:deployment-config": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-deployment-config.mjs",
    "test:deployment-db": "node scripts/test-deployment-db.mjs",
    "test:deploy-init": "node scripts/test-deploy-init.mjs",
    "test:deployment-docker": "bash scripts/test-deployment-docker.sh",
    "site:roles": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/site-roles.mjs",
    "question:publish": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/question-publication.mjs",
    "provider:bindings": "node --env-file-if-exists=.env.local --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/provider-bindings.mjs",
    "test:server-chat": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-server-chat.mjs",
    "test:legacy-import": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-legacy-import.mjs",
    "test:assistant-run": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-assistant-run.mjs",
    "test:provider-connection": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-provider-connection.mjs",
    "test:auth-link": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-auth-link-route.mjs",
    "test:question-overrides": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-private-overrides.mjs",
    "test:question-proposals": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-change-proposals.mjs",
    "test:question-review": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-review.mjs",
    "test:question-publication": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-publication.mjs",
    "test:question-review-migration": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-review-migration.mjs",
    "question:revisions": "node scripts/apply-question-revisions.mjs",
    "test:question-revisions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-revisions.mjs",
    "test:question-overrides-browser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-private-overrides-browser.mjs",
    "test:question-review-browser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-question-review-browser.mjs",
    "test:coach-account-browser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-coach-account-browser.mjs",
    "test:coach-assistant-browser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-coach-assistant-browser.mjs",
    "test:coach": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/coach-experience.test.mjs",
    "test:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-backup-validation.mjs",
    "test:study-store": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-study-store.mjs",
    "test:siwc": "node --test server/*.test.mjs scripts/*.test.mjs",
    "verify:static-boundary": "node scripts/test-static-boundary.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-harden": "1.1.8",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "2.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
