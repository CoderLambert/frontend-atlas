# Copy with ./deploy.sh init; keep the resulting .env.deploy private (chmod 600).
# Local mode: http://127.0.0.1:3010 or http://localhost:3010
# Public mode: https://learn.example.com (DNS must point here first)
DEPLOYMENT_MODE=local
PUBLIC_URL=http://127.0.0.1:3010
PUBLIC_HOST=
APP_PORT=3010
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
APP_UID=1000
APP_GID=1000
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_ATLAS_ALLOW_DB_INITIALIZE=0
